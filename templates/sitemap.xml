{%- import "macros.html" as macros -%}
<?xml version="1.0" encoding="UTF-8"?>
{#- Zola's sitemap, without pages that carry noindex: the search page and tag
    pages with a single item. -#}
{%- set tags = get_taxonomy(kind="tags") %}
{%- set_global thin = [get_url(path="@/search/_index.md")] %}
{%- for term in tags.items %}
{%- set total = macros::tag_item_count(term=term) | int %}
{%- if total < 2 %}{% set_global thin = thin | concat(with=term.permalink) %}{% endif %}
{%- endfor %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for sitemap_entry in entries %}
    {%- if sitemap_entry.permalink not in thin %}
    <url>
        <loc>{{ sitemap_entry.permalink | escape_xml | safe }}</loc>
        {%- if sitemap_entry.updated %}
        <lastmod>{{ sitemap_entry.updated }}</lastmod>
        {%- endif %}
    </url>
    {%- endif %}
    {%- endfor %}
</urlset>
